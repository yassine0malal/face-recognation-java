<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.shape.*?>
<?import java.net.URL?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.facialaccess.presentation.AuditLogsController"
    style="-fx-background-color: #F8FAFC; -fx-background: #F8FAFC; -fx-border-color: transparent;">

    <stylesheets>
        <URL value="@../css/global.css" />
        <URL value="@../css/dashboard.css" />
        <URL value="@../css/audit_logs.css" />
    </stylesheets>

    <VBox spacing="24" style="-fx-padding: 32px; -fx-background-color: #F8FAFC;">

        <!-- ── PAGE HEADER ── -->
        <HBox alignment="CENTER_LEFT" spacing="16">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Security Audit Logs" styleClass="page-title" />
                <Label text="Real-time technical analysis of all system authentication and node events."
                    styleClass="page-subtitle" />
            </VBox>
            <Button fx:id="btnExportPdf" text="Export PDF" styleClass="btn-export-outline"
                onAction="#handleExportPdf">
                <graphic>
                    <SVGPath content="M20 2H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-8.5 7.5c0 .83-.67 1.5-1.5 1.5H9v2H7.5V7H10c.83 0 1.5.67 1.5 1.5v1zm5 2c0 .83-.67 1.5-1.5 1.5h-2.5V7H15c.83 0 1.5.67 1.5 1.5v3zm4-3H19v1h1.5V11H19v2h-1.5V7h3v1.5zM9 9.5h1v-1H9v1zM4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm10 5.5h1v-3h-1v3z"
                        fill="#334155" scaleX="0.75" scaleY="0.75" />
                </graphic>
            </Button>
            <Button fx:id="btnExportCsv" text="Export CSV" styleClass="btn-export-filled"
                onAction="#handleExportCsv">
                <graphic>
                    <SVGPath content="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"
                        fill="#FFFFFF" scaleX="0.75" scaleY="0.75" />
                </graphic>
            </Button>
        </HBox>

        <!-- ── CHART + SYSTEM HEALTH ROW ── -->
        <HBox spacing="16" alignment="TOP_LEFT">

            <!-- Access Timeline Chart -->
            <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="12">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Access Timeline Visualization" styleClass="section-title"
                        HBox.hgrow="ALWAYS" />
                    <HBox spacing="6" alignment="CENTER" styleClass="legend-box">
                        <Rectangle width="12" height="12" arcWidth="3" arcHeight="3"
                            fill="#BFDBFE" />
                        <Label text="Auth Attempts" styleClass="legend-label" />
                    </HBox>
                </HBox>

                <BarChart fx:id="timelineChart" prefHeight="220" legendVisible="false"
                    animated="false"
                    style="-fx-background-color: transparent; -fx-padding: 4 0 0 0;">
                    <xAxis>
                        <CategoryAxis fx:id="timelineXAxis" tickLabelFill="#94A3B8"
                            style="-fx-tick-label-font-size: 10px;" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis fx:id="timelineYAxis" tickLabelFill="#94A3B8"
                            style="-fx-tick-label-font-size: 10px;" minorTickVisible="false" />
                    </yAxis>
                </BarChart>
            </VBox>

            <!-- System Health Card -->
            <VBox fx:id="systemHealthCard" styleClass="system-health-card"
                prefWidth="200" minWidth="180" maxWidth="220" spacing="12"
                alignment="TOP_LEFT">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <HBox alignment="CENTER"
                        style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 50%; -fx-min-width: 40px; -fx-min-height: 40px; -fx-max-width: 40px; -fx-max-height: 40px;">
                        <SVGPath
                            content="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"
                            fill="#FFFFFF" scaleX="0.85" scaleY="0.85" />
                    </HBox>
                </HBox>
                <Label text="System&#10;Health" styleClass="health-title" wrapText="true" />
                <Label text="All security nodes reporting nominal performance."
                    styleClass="health-desc" wrapText="true" />
                <Region VBox.vgrow="ALWAYS" />
                <Label text="UPTIME" styleClass="health-uptime-label" />
                <Label fx:id="uptimeLabel" text="99.998%" styleClass="health-uptime-value" />
            </VBox>

        </HBox>

        <!-- ── FILTER BAR ── -->
        <HBox styleClass="filter-bar" alignment="CENTER_LEFT" spacing="12">
            <Label text="Filter By:" styleClass="filter-label" />
            <ComboBox fx:id="levelFilter" promptText="All Security Levels"
                styleClass="filter-combo" prefWidth="180" />
            <DatePicker fx:id="datePicker" promptText="dd/mm/yyyy"
                styleClass="filter-date" prefWidth="160" />
            <TextField fx:id="nodeIdFilter" promptText="Node ID (e.g. ND-88)"
                styleClass="filter-text" prefWidth="200" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Apply Filters" styleClass="btn-apply-filter"
                onAction="#handleApplyFilters" />
        </HBox>

        <!-- ── LOGS TABLE ── -->
        <VBox styleClass="card" spacing="0">
            <TableView fx:id="logsTable" prefHeight="400"
                style="-fx-background-color: transparent; -fx-border-color: transparent;">
                <columns>
                    <TableColumn fx:id="colLevel"     text="LEVEL"      prefWidth="110" />
                    <TableColumn fx:id="colTimestamp" text="TIMESTAMP"  prefWidth="160" />
                    <TableColumn fx:id="colNodeId"    text="NODE ID"    prefWidth="130" />
                    <TableColumn fx:id="colEventType" text="EVENT TYPE" prefWidth="160" />
                    <TableColumn fx:id="colDetails"   text="DETAILS"    prefWidth="260" />
                    <TableColumn fx:id="colStatus"    text="STATUS"     prefWidth="130" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

    </VBox>
</ScrollPane>
