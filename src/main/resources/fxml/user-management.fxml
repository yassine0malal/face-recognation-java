<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="24.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.facialaccess.presentation.UserManagementController">
    <children>
        
        <VBox spacing="4.0">
            <Label text="Personnel Control Directory" styleClass="heading-title" />
            <Label text="Manage identity biometric profiles and clearance status levels." styleClass="sub-text" />
        </VBox>
        
        <HBox spacing="16.0">
            <children>
                <VBox HBox.hgrow="ALWAYS" styleClass="card-panel" spacing="8.0">
                    <Label text="Authorized Entries" styleClass="sub-text" />
                    <Label text="1,284" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2563EB;" />
                </VBox>
                <VBox HBox.hgrow="ALWAYS" styleClass="card-panel" spacing="8.0">
                    <Label text="Access Violations" styleClass="sub-text" />
                    <Label text="43" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #EF4444;" />
                </VBox>
            </children>
        </HBox>
        
        <VBox VBox.vgrow="ALWAYS" styleClass="card-panel" spacing="12.0">
            <children>
                <Label text="Registered Security Profiles" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" />
                <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
                    </TableView>
            </children>
        </VBox>
        
    </children>
</VBox>