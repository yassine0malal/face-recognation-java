<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.facialaccess.presentation.WelcomeController"
            prefWidth="1024" prefHeight="768"
            stylesheets="@../css/login.css"
            style="-fx-background-color: linear-gradient(to bottom, #e8eef5 0%, #d4dce8 100%);">

    <!-- TOP: Header identique au login -->
    <top>
        <BorderPane style="-fx-padding: 25;">
            <left>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <FontIcon iconLiteral="mdi2s-shield-check" iconSize="32" iconColor="#0d47a1"/>
                    <Label text="Sentinel Precision"
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0d47a1;"/>
                </HBox>
            </left>
            <right>
                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Region styleClass="status-dot"/>
                    <Label text="SYSTEM READY"
                           style="-fx-font-size: 11px; -fx-text-fill: #555; -fx-font-weight: 600;"/>
                    <Button style="-fx-background-color: transparent; -fx-cursor: hand; -fx-border-width: 0;">
                        <graphic>
                            <FontIcon iconLiteral="mdi2i-information-outline" iconSize="22" iconColor="#999"/>
                        </graphic>
                    </Button>
                </HBox>
            </right>
        </BorderPane>
    </top>

    <!-- CENTER: Carte de bienvenue -->
    <center>
        <VBox alignment="CENTER">
            <VBox alignment="CENTER" spacing="0" maxWidth="560" styleClass="login-card">
                <VBox alignment="CENTER" spacing="30" style="-fx-padding: 55 55 50 55;">

                    <!-- Icône et titre -->
                    <VBox alignment="CENTER" spacing="12">
                        <FontIcon iconLiteral="mdi2s-shield-account" iconSize="64" iconColor="#0d47a1"/>
                        <Label text="Welcome to BioAccess"
                               style="-fx-font-size: 26px; -fx-font-weight: 600; -fx-text-fill: #1a1a1a;"/>
                        <Label text="Select your access method to continue"
                               style="-fx-font-size: 13px; -fx-text-fill: #777;"/>
                    </VBox>

                    <!-- Séparateur -->
                    <Separator prefWidth="460"/>

                    <!-- Bouton Face Scan -->
                    <Button fx:id="scanButton" onAction="#handleFaceScan"
                            prefWidth="460" styleClass="welcome-option-btn">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="18" style="-fx-padding: 4 0;">
                                <StackPane style="-fx-background-color: #e3f2fd; -fx-background-radius: 10;
                                                  -fx-min-width: 52; -fx-min-height: 52;
                                                  -fx-max-width: 52; -fx-max-height: 52;">
                                    <FontIcon iconLiteral="mdi2f-face-recognition" iconSize="28" iconColor="#1565c0"/>
                                </StackPane>
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Face Scan Access"
                                           style="-fx-font-size: 15px; -fx-font-weight: 600; -fx-text-fill: #1a1a1a;"/>
                                    <Label text="Quick biometric authentication"
                                           style="-fx-font-size: 12px; -fx-text-fill: #777;"/>
                                </VBox>
                                <FontIcon iconLiteral="mdi2c-chevron-right" iconSize="22" iconColor="#bbb"/>
                            </HBox>
                        </graphic>
                    </Button>

                    <!-- Bouton Admin -->
                    <Button fx:id="adminButton" onAction="#handleAdminLogin"
                            prefWidth="460" styleClass="welcome-option-btn">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="18" style="-fx-padding: 4 0;">
                                <StackPane style="-fx-background-color: #fff3e0; -fx-background-radius: 10;
                                                  -fx-min-width: 52; -fx-min-height: 52;
                                                  -fx-max-width: 52; -fx-max-height: 52;">
                                    <FontIcon iconLiteral="mdi2s-shield-lock" iconSize="28" iconColor="#e65100"/>
                                </StackPane>
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Admin Access"
                                           style="-fx-font-size: 15px; -fx-font-weight: 600; -fx-text-fill: #1a1a1a;"/>
                                    <Label text="System management and configuration"
                                           style="-fx-font-size: 12px; -fx-text-fill: #777;"/>
                                </VBox>
                                <FontIcon iconLiteral="mdi2c-chevron-right" iconSize="22" iconColor="#bbb"/>
                            </HBox>
                        </graphic>
                    </Button>

                </VBox>
            </VBox>
        </VBox>
    </center>

    <!-- BOTTOM: Footer identique au login -->
    <bottom>
        <VBox alignment="CENTER" spacing="8" style="-fx-padding: 0 0 25 0;">
            <HBox alignment="CENTER" spacing="20">
                <Label text="SENTINEL PRECISION"
                       style="-fx-font-size: 11px; -fx-text-fill: #555; -fx-font-weight: 700; -fx-letter-spacing: 1px;"/>
                <Label text="© 2026 Sentinel Precision Biometrics. All Rights Reserved. Confidential System Access."
                       style="-fx-font-size: 10px; -fx-text-fill: #888;"/>
            </HBox>
            <HBox alignment="CENTER" spacing="20">
                <Hyperlink text="System Support" styleClass="hyperlink"/>
                <Hyperlink text="Privacy Protocol" styleClass="hyperlink"/>
                <Hyperlink text="Security Policy" styleClass="hyperlink"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
