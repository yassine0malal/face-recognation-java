<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.facialaccess.presentation.MainLayoutController"
    prefWidth="1280.0" prefHeight="800.0" minWidth="900.0" minHeight="650.0" styleClass="root">

    <stylesheets>
        <URL value="@../../css/global.css" />
        <URL value="@../../css/dashboard.css" />
    </stylesheets>

    <!-- Center: Sidebar (full-height) + right content column (header + content area) -->
    <center>
        <HBox>
            <!-- Full-height Sidebar -->
            <VBox prefWidth="220.0" minWidth="200.0" maxWidth="220.0" styleClass="sidebar" alignment="TOP_LEFT">
                <Label text="VigilantCore" styleClass="heading-title" />
                <Label text="ADMIN CONTROL CENTER" styleClass="sub-text" />

                <Button text="Dashboard" maxWidth="Infinity" styleClass="sidebar-button-active" onAction="#handleShowDashboardView">
                    <graphic>
                        <SVGPath content="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z" fill="#FFFFFF" scaleX="0.85" scaleY="0.85" />
                    </graphic>
                </Button>
                <Button text="Personnel" maxWidth="Infinity" styleClass="sidebar-button" onAction="#handleShowUserManagementView">
                    <graphic>
                        <SVGPath content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" fill="#6B7084" scaleX="0.85" scaleY="0.85" />
                    </graphic>
                </Button>
                <Button text="Logs" maxWidth="Infinity" styleClass="sidebar-button" onAction="#handleShowLogsView">
                    <graphic>
                        <SVGPath content="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" fill="#6B7084" scaleX="0.85" scaleY="0.85" />
                    </graphic>
                </Button>
                <Button text="Settings" maxWidth="Infinity" styleClass="sidebar-button" onAction="#handleShowSettingsView">
                    <graphic>
                        <SVGPath content="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 00.12-.61l-1.92-3.32a.49.49 0 00-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 00-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.49.49 0 00-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.07.62-.07.94s.02.64.07.94l-2.03 1.58a.49.49 0 00-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6A3.6 3.6 0 1115.6 12 3.61 3.61 0 0112 15.6z" fill="#6B7084" scaleX="0.85" scaleY="0.85" />
                    </graphic>
                </Button>

                <Region VBox.vgrow="ALWAYS" />

                <HBox spacing="12" alignment="CENTER_LEFT"
                    style="-fx-padding: 14 16; -fx-background-color: transparent;">
                    <Circle radius="20.0" fill="#4A5568"
                        style="-fx-stroke: #3B5BDB; -fx-stroke-width: 2;" />
                    <VBox alignment="CENTER_LEFT" spacing="2">
                        <Label text="Operator 01"
                            style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #1E1B4B;" />
                        <HBox alignment="CENTER_LEFT" spacing="5">
                            <Circle radius="4" fill="#10B981" />
                            <Label text="SYSTEM SECURE"
                                style="-fx-font-size: 10px; -fx-text-fill: #10B981; -fx-font-weight: 700;" />
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Right column: Header on top, then content area below -->
            <VBox HBox.hgrow="ALWAYS">
                <!-- Header bar (only above content area, not the sidebar) -->
                <HBox alignment="CENTER_LEFT" prefHeight="72.0" spacing="24.0"
                    style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0; -fx-padding: 0 32px;" minHeight="60.0">
                    <HBox alignment="CENTER_LEFT" spacing="12.0" HBox.hgrow="ALWAYS" maxWidth="520.0" maxHeight="40.0"
                        style="-fx-background-color: #F1F5F9; -fx-background-radius: 9999px; -fx-padding: 8px 16px; -fx-border-color: #E2E8F0; -fx-border-radius: 9999px;">
                        <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="#94A3B8" scaleX="0.8" scaleY="0.8" />
                        <TextField promptText="Search personnel, access logs, or locations..."
                            style="-fx-background-color: transparent; -fx-border-width: 0; -fx-padding: 0; -fx-font-size: 14px; -fx-text-fill: #334155; -fx-prompt-text-fill: #94A3B8;"
                            HBox.hgrow="ALWAYS" />
                    </HBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <HBox alignment="CENTER" spacing="16.0">
                        <Button style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 8px; -fx-background-radius: 8px;">
                            <graphic>
                                <SVGPath content="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z" fill="#64748B" scaleX="0.9" scaleY="0.9" />
                            </graphic>
                        </Button>
                        <Button style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 8px; -fx-background-radius: 8px;">
                            <graphic>
                                <SVGPath content="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM9 6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9V6zm9 14H6V10h12v10zm-6-3c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z" fill="#64748B" scaleX="0.9" scaleY="0.9" />
                            </graphic>
                        </Button>
                        <Button style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 8px; -fx-background-radius: 8px;">
                            <graphic>
                                <SVGPath content="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z" fill="#64748B" scaleX="0.9" scaleY="0.9" />
                            </graphic>
                        </Button>
                        <Region prefWidth="8.0" />
                        <Label text="John Admin" style="-fx-font-weight: bold; -fx-text-fill: #1E293B;" />
                    </HBox>
                </HBox>

                <!-- Dynamic content area -->
                <StackPane fx:id="mainContentArea" alignment="TOP_LEFT" VBox.vgrow="ALWAYS" />
            </VBox>
        </HBox>
    </center>

    <!-- Global Footer (spans full width including sidebar) -->
    <bottom>
        <HBox alignment="CENTER" prefHeight="40.0" spacing="16.0"
            style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0; -fx-padding: 0 32px;">
            <Label text="© 2026 VigilantCore | Admin Control Center" style="-fx-text-fill: #64748B; -fx-font-size: 12px; -fx-font-family: 'Inter';" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="System Status: Secure" style="-fx-text-fill: #10B981; -fx-font-weight: bold; -fx-font-size: 12px; -fx-font-family: 'Inter';" />
            <Label text="v1.0.0" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px; -fx-font-family: 'Inter';" />
        </HBox>
    </bottom>

</BorderPane>
