<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.facialaccess.presentation.DashboardController"
    prefWidth="1440.0" prefHeight="900.0" styleClass="root">

    <stylesheets>
        <URL value="@../css/global.css" />
        <URL value="@../css/dashboard.css" />
    </stylesheets>

    <left>
        <VBox prefWidth="280.0" styleClass="sidebar" alignment="TOP_LEFT">
            <Label text="VigilantCore" styleClass="heading-title" />
            <Label text="Admin Control Center" styleClass="sub-text" />

            <Region prefHeight="16.0" />

            <Button text="Dashboard" maxWidth="Infinity" styleClass="sidebar-button-active" onAction="#handleShowDashboardView">
                <graphic>
                    <SVGPath content="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z" fill="#4B5563" scaleX="0.8" scaleY="0.8" />
                </graphic>
            </Button>
            <Button text="Personnel" maxWidth="Infinity" styleClass="sidebar-button" onAction="#handleShowUserManagementView">
                <graphic>
                    <SVGPath content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" fill="#4B5563" scaleX="0.8" scaleY="0.8" />
                </graphic>
            </Button>
            <Button text="Logs" maxWidth="Infinity" styleClass="sidebar-button" onAction="#handleShowLogsView">
                <graphic>
                    <SVGPath content="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" fill="#4B5563" scaleX="0.8" scaleY="0.8" />
                </graphic>
            </Button>
            <Button text="Live Camera" maxWidth="Infinity" styleClass="sidebar-button" onAction="#handleShowCameraView">
                <graphic>
                    <SVGPath content="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z" fill="#4B5563" scaleX="0.8" scaleY="0.8" />
                </graphic>
            </Button>
                
            <Region VBox.vgrow="ALWAYS" />

            <HBox spacing="12"
                style="-fx-background-color: #E2E8F0; -fx-padding: 12; -fx-background-radius: 8;">
                <Circle radius="16.0" fill="#64748B" />
                <VBox alignment="CENTER_LEFT">
                    <Label text="Operator 01" style="-fx-font-weight: bold; -fx-text-fill: #0F172A;" />
                    <HBox alignment="CENTER_LEFT" spacing="4">
                        <Circle radius="3" fill="#10B981" />
                        <Label text="SYSTEM SECURE"
                            style="-fx-font-size: 10px; -fx-text-fill: #10B981; -fx-font-weight: bold;" />
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="mainContentArea" alignment="TOP_LEFT" />
    </center>
</BorderPane>