<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.facialaccess.presentation.LoginController"
            prefWidth="1024" prefHeight="768"
            stylesheets="@../css/login.css"
            style="-fx-background-color: linear-gradient(to bottom, #e8eef5 0%, #d4dce8 100%);">
    
    <!-- TOP: Header -->
    <top>
        <BorderPane style="-fx-padding: 25;">
            <!-- Left: Logo and Title -->
            <left>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <FontIcon iconLiteral="mdi2s-shield-check" iconSize="32" iconColor="#0d47a1"/>
                    <Label text="Sentinel Precision" 
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0d47a1;"/>
                </HBox>
            </left>
            
            <!-- Right: System Status -->
            <right>
                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Region styleClass="status-dot"/>
                    <Label text="SYSTEM READY" 
                           style="-fx-font-size: 11px; -fx-text-fill: #555; -fx-font-weight: 600; -fx-letter-spacing: 0.5px;"/>
                    <Button style="-fx-background-color: transparent; -fx-cursor: hand; -fx-border-width: 0;">
                        <graphic>
                            <FontIcon iconLiteral="mdi2i-information-outline" iconSize="22" iconColor="#999"/>
                        </graphic>
                    </Button>
                </HBox>
            </right>
        </BorderPane>
    </top>
    
    <!-- CENTER: Login Card -->
    <center>
        <VBox alignment="CENTER">
            <VBox alignment="CENTER" spacing="0" maxWidth="420" styleClass="login-card">
                
                <VBox alignment="CENTER" spacing="28" style="-fx-padding: 55 45 45 45;">
                    
                    <!-- Title -->
                    <Label text="Secure Access" 
                           style="-fx-font-size: 30px; -fx-font-weight: 600; -fx-text-fill: #1a1a1a; -fx-padding: 0 0 5 0;"/>
                    
                    <!-- Username Field Container -->
                    <VBox spacing="10" prefWidth="320">
                        <Label text="OPERATOR USERNAME" 
                               style="-fx-font-size: 11px; -fx-text-fill: #777; -fx-font-weight: 600; -fx-letter-spacing: 0.5px;"/>
                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="input-container" prefWidth="320">
                            <FontIcon iconLiteral="mdi2a-account-outline" iconSize="20" iconColor="#999"/>
                            <TextField fx:id="usernameField" promptText="Enter system ID"
                                       style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 14px;"
                                       HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </VBox>
                    
                    <!-- Password Field Container -->
                    <VBox spacing="10" prefWidth="320">
                        <Label text="ACCESS KEY" 
                               style="-fx-font-size: 11px; -fx-text-fill: #777; -fx-font-weight: 600; -fx-letter-spacing: 0.5px;"/>
                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="input-container" prefWidth="320">
                            <FontIcon iconLiteral="mdi2l-lock-outline" iconSize="20" iconColor="#999"/>
                            <PasswordField fx:id="passwordField" promptText="••••••••••••"
                                           style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 14px;"
                                           HBox.hgrow="ALWAYS"/>
                            <Button fx:id="togglePasswordBtn" onAction="#togglePasswordVisibility" styleClass="toggle-password-btn">
                                <graphic>
                                    <FontIcon fx:id="eyeIcon" iconLiteral="mdi2e-eye-outline" iconSize="20" iconColor="#999"/>
                                </graphic>
                            </Button>
                        </HBox>
                    </VBox>
                    
                    <!-- Error Message -->
                    <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" 
                           maxWidth="320" visible="false" managed="false"/>
                    
                    <!-- Login Button -->
                    <Button fx:id="loginButton" text="Initialize Session" onAction="#handleLogin"
                            styleClass="login-button" prefWidth="320">
                        <graphic>
                            <FontIcon iconLiteral="mdi2l-login" iconSize="18" iconColor="white"/>
                        </graphic>
                    </Button>
                    
                </VBox>
                
            </VBox>
        </VBox>
    </center>
    
    <!-- BOTTOM: Footer -->
    <bottom>
        <VBox alignment="CENTER" spacing="8" style="-fx-padding: 0 0 25 0;">
            <HBox alignment="CENTER" spacing="20">
                <Label text="SENTINEL PRECISION" 
                       style="-fx-font-size: 11px; -fx-text-fill: #555; -fx-font-weight: 700; -fx-letter-spacing: 1px;"/>
                <Label text="© 2024 Sentinel Precision Biometrics. All Rights Reserved. Confidential System Access." 
                       style="-fx-font-size: 10px; -fx-text-fill: #888;"/>
            </HBox>
            <HBox alignment="CENTER" spacing="20">
                <Hyperlink text="System Support" styleClass="hyperlink"/>
                <Hyperlink text="Privacy Protocol" styleClass="hyperlink"/>
                <Hyperlink text="Security Policy" styleClass="hyperlink"/>
            </HBox>
        </VBox>
    </bottom>
    
</BorderPane>
